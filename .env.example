# Copy to .env and fill in locally. Never commit .env or a real key.
# Narrative text calls DeepSeek via an OpenAI-compatible chat completions API.
# Calculations do not use the model. If the key is absent, the page still runs
# and shows computed facts without a model-written 原因说明.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
